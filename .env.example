# SwasthCart AI - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# AWS Configuration
AWS_REGION=ap-south-2
AWS_S3_BUCKET=swasthcart-products
AWS_DYNAMODB_TABLE=swasthcart_sessions
AWS_CLOUDWATCH_LOG_GROUP=/aws/swasthcart

# AWS Bedrock Models
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
AWS_BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v1
AWS_BEDROCK_TIMEOUT=5

# Application Settings
APP_SESSION_TTL_HOURS=2
APP_MAX_PRODUCTS_DISPLAY=100
APP_CART_IMPROVEMENT_THRESHOLD=60

# RAG Configuration
RAG_VECTOR_DIMENSION=1536
RAG_EMBEDDING_CACHE_SIZE=1000
RAG_SIMILARITY_THRESHOLD=0.6
RAG_TOP_K_RESULTS=5

# Optional: Override AWS credentials (not recommended, use aws configure instead)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
