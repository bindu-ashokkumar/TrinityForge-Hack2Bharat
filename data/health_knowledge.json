      "condition": "IBS",
      "source": "American Gastroenterological Association",
      "guideline": "Follow a low-FODMAP diet. Avoid artificial sweeteners, excess sodium, and preservatives that irritate the gut lining.",
      "threshold": {"nutrient": "preservatives", "max_per_serving": 0, "severity": "moderate"},
      "tags": ["FODMAP", "gut health", "preservatives", "artificial sweeteners"]
    },
