      "condition": "Osteoporosis",
      "source": "National Osteoporosis Foundation",
      "guideline": "High sodium intake increases calcium excretion through kidneys, weakening bones. Limit sodium to under 2,300mg/day.",
      "threshold": {"nutrient": "sodium_mg", "max_per_serving": 300, "severity": "moderate"},
      "tags": ["calcium", "bone density", "sodium", "vitamin D"]
